# Copy to .env on the server (never commit the real .env — it's gitignored)
# and fill in real values. Used by docker-compose.prod.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=royal_vacation

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=change-me

# Comma-free JSON array string, matching backend/app/core/config.py's parsing.
CORS_ORIGINS=["https://example.com","https://www.example.com","https://admin.example.com"]

# The public URL browsers will use to reach the API — baked into the
# client/admin builds at build time (NEXT_PUBLIC_* vars are compile-time).
PUBLIC_API_URL=https://api.example.com
