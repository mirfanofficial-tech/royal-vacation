# Copy this file to `.env` in the same directory and fill in real values —
# docker-compose.prod.yml and the Caddyfile both read from it.
#
# .env files don't support referencing other variables within the same file
# (that's a shell thing, not a docker-compose thing), so domain-based values
# below are spelled out in full rather than composed from DOMAIN.

# ---- Domain & TLS ----------------------------------------------------------
DOMAIN=royalvacation.com
LETSENCRYPT_EMAIL=you@example.com

# ---- Database ---------------------------------------------------------------
# Any strong random string — this becomes the Postgres superuser password
# inside the `db` container, generated fresh, never reused from anywhere else.
POSTGRES_PASSWORD=

# ---- Backend secrets ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
# JSON array, no trailing slashes — every origin the API must accept requests from.
CORS_ORIGINS=["https://royalvacation.com","https://www.royalvacation.com","https://admin.royalvacation.com"]

# ---- Public URLs (baked into the client/admin bundles at build time) -----
NEXT_PUBLIC_API_URL=https://api.royalvacation.com
NEXT_PUBLIC_SITE_URL=https://royalvacation.com
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional — leave blank to ship without Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
